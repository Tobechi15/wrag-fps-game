# Copy this file to .env and fill in real values. .env is gitignored - never
# commit real credentials, even local-dev-only ones.

DATABASE_URL=postgresql://postgres:devpassword@127.0.0.1:5432/wrag_fps
# Format: postgresql://<user>:<password>@<host>:<port>/<database> - there's
# no separate password field, it's embedded in this one URL. Percent-encode
# any special characters in the password (@, :, /, #, ?, %, etc. - they're
# URL delimiters otherwise), e.g.
# node -e "console.log(encodeURIComponent('your-password'))"
# A hosted Postgres provider almost always requires SSL - append
# ?sslmode=require to the end of the URL if so (pg-connection-string parses
# this straight out of the URL, no code change needed).

# Set to `production` on a real deployment (most hosting platforms set this
# automatically) - makes the session cookie `secure` (https-only, see
# server/src/api/server.js) instead of the local-http-friendly default.
# Leave unset for local dev.
NODE_ENV=production

# The port the WebSocket game server + Express API (one shared listener,
# see server/src/index.js) bind to. Leave unset for local dev (falls back
# to 8080). On a real host, do NOT set this yourself - platforms like
# Render assign PORT automatically and expect your app to read whatever
# value THEY set, not a fixed one of your own choosing.
PORT=

# Used to sign session cookies. Any long random string works for local dev -
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-string

# --- Game economy/difficulty tuning (all optional - see server/src/match/modes.js
# and server/src/economy/wallet.js for the fallback defaults used when unset,
# and DEV_README.md for how each one is actually used) ---

# % of every Versus/Coop kill payout and Private stake-pool payout held back
# as house margin, per player winnings - NOT taken from a player's own
# extraction/banking of their own pot, and not taken from entry-stake
# refunds (leaving before a match starts isn't a win).
HOUSE_RAKE_PERCENT=10

# Flat entry stake (PTS) for Versus/Coop - Private has no fixed stake, the
# host sets one per room instead (see server/src/lobby/privateRooms.js).
ENTRY_STAKE=100

# Starting balance (PTS) a brand new account gets - also the DEFAULT on the
# users.balance column itself (see schema.sql); this env var only affects
# NEW rows going forward if you ever change the column default to match it.
STARTING_BALANCE=500

# Match time limit, in MINUTES (Survival has no time limit at all - see
# match.js's timeLimitTimeoutId guard).
MATCH_TIME_LIMIT_MINUTES=3

# Bot difficulty - baseline (Versus/Private/Survival) vs. Coop's own
# slightly-higher "ally" values (see modes.js's COOP_BOT_* comment for why
# Coop bots are tuned separately).
BOT_HIT_CHANCE=0.68
BOT_SHOT_INTERVAL_MS=1900
BOT_SPEED=4
COOP_BOT_HIT_CHANCE=0.72
COOP_BOT_SHOT_INTERVAL_MS=1800

# A bot kill pays this % of whatever the mode's normal (real-player) kill
# value is - keeps a bot-padded match from farming the same kill-point
# value as actually eliminating a real opponent, which would otherwise let
# the economy get drained for free (see modes.js's botKillValue).
BOT_KILL_VALUE_PERCENT=50

# Coop lives/respawns - how many times a real player (COOP_MAX_DEATHS) or a
# Coop bot (COOP_MAX_BOT_RESPAWNS) can come back before being out for good.
# COOP_MAX_DEATHS also drives Coop's kill-point math directly: a kill is
# worth ENTRY_STAKE / COOP_MAX_DEATHS, since that's how many kills it
# actually takes to eliminate a player who staked ENTRY_STAKE to enter -
# retuning this retunes the kill payout automatically, no separate number
# to keep in sync.
COOP_MAX_DEATHS=3
COOP_MAX_BOT_RESPAWNS=2

# How many total participants (real players + bot-filled) a Versus or Coop
# match holds. Coop must stay EVEN (two balanced teams) - an odd value here
# is rounded up to the next even number automatically (see modes.js).
VERSUS_MATCH_SIZE=20
COOP_MATCH_SIZE=10

# How long a Coop/Private respawn takes, in SECONDS - the dying player sees
# a countdown banner for this long before actually reappearing (see
# match.js's beginRespawn/finishRespawn and client/src/gameScreen.js's
# 'respawn-countdown' handler). They're untargetable for this whole window.
RESPAWN_DELAY_SECONDS=5

# Comma-separated email addresses (case-insensitive) that get the admin
# dashboard (/admin.html - house ledger: fees collected, profit) auto-
# granted the first time they log in. Empty by default - nobody is admin
# until you list an account here. There's no admin-management UI; add/
# remove emails here and have that account log in again (or out and back
# in) to apply the change. See DEV_README.md's "House ledger" section.
ADMIN_EMAILS=rtrr@gmail.com
