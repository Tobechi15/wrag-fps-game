# Copy to .env.production (or .env) and fill in real values for a Vercel
# deployment. Vite bakes VITE_-prefixed vars into the built bundle at BUILD
# time - set these as Vercel project Environment Variables instead of a
# committed file; a local .env is only useful for testing a production-like
# build locally with `vite build && vite preview`. Leave everything unset
# for normal local dev (see client/src/app.js's fallback logic) - none of
# this is needed to just run `npm run dev`.

# Full ws:// or wss:// URL for the game server (server/src/index.js),
# e.g. wss://wrag-fps.onrender.com - REQUIRED once the client and the
# backend are two unrelated Vercel/Render domains with no shared-host
# relationship (see app.js's gameServerUrlOverride - without this, the
# client would try to guess the backend's address from its OWN hostname,
# which is wrong once they're on different hosts entirely).
VITE_GAME_SERVER_URL=

# The deployed site's dashboard URL, e.g. https://wrag-fps.vercel.app/dashboard.html
# - used by the post-match screen's "Back to Dashboard" button (see
# postMatchScreen.js).
VITE_DASHBOARD_URL=
